PROJECT_NAME=cano
SECRET_KEY=yoursecretkeyhere
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=changethis

# Supabase
SUPABASE_URL=http://localhost:54321
SUPABASE_KEY=your-supabase-key-here

# Frontend
FRONTEND_HOST=http://localhost:3000
BACKEND_CORS_ORIGINS=http://localhost:8081,http://192.168.x.x:8081

# Environment
ENVIRONMENT=local

# XMPP - Cuenta del bot
XMPP_BOT_JID=your-bot@your-xmpp-domain.com

# XMPP - Admin del servidor
XMPP_ADMIN_USER=admin
XMPP_ADMIN_PASSWORD=adminpassword
XMPP_DOMAIN=your-xmpp-domain.com
XMPP_REST_URL=https://your-xmpp-domain.com:5281/rest

# XMPP - Cifrado (32+ caracteres)
XMPP_ENCRYPTION_KEY=changeme-encryption-key-32-chars

BOT_USERNAME=username-for-bot
BOT_PASSWORD=password-for-bot
